# ===== 一起旅行 SKILL · 环境变量示例 =====
# 复制本文件为 .env 并填入真实 key, .env 已加入 .gitignore 不会上传
# cp .env.example .env
# 然后填入下面的真实 key

# ===== 高德地图 API =====
# 申请: https://lbs.amap.com/dev/key/app
# 类型: Web 端 (JS API) — 同时给浏览器端 + REST API 用
# Referer 白名单: 你的域名/*  (例如 *.example.com/*)
AMAP_KEY=
# JS API 2.0 强制要求的安全码 (跟 AMAP_KEY 一起在后台生成)
AMAP_SECURITY=

# ===== 视觉 LLM (OCR + 分类 + 美学 一站式, 一个调用解决阶段 1.5) =====
# 推荐: 阿里云 DashScope (qwen-vl-plus / qwen-vl-max)
# 申请: https://dashscope.console.aliyun.com/apiKey
# 也支持任何 OpenAI 兼容协议 (Azure / OpenRouter / 自部署 vLLM)
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# ===== 验证阈值 (可调, 阶段 2.5 交叉验证用) =====
# 店招 vs POI 名称相似度下限 (0-1, 低于此视为不匹配)
VALIDATE_SHOP_POI_MIN=0.7
# EXIF GPS 距 POI 距离上限 (米, 超过此视为不匹配)
VALIDATE_DISTANCE_MAX_M=100
# 收据时间 vs EXIF 时间偏差上限 (分钟)
VALIDATE_RECEIPT_TIME_MAX_MIN=60

# ===== 通知 (可选, 阶段 9 预算预警用) =====
# 企业微信机器人 webhook (预算预警时推送)
WECOM_WEBHOOK=
# 邮件 (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
